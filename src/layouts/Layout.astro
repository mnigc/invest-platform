---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import ClientRoot from '../components/ClientRoot';

interface Props {
  title?: string;
}

const { title = 'MACRO EDGE - 宏观投资研究终端' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <script is:inline>
      // 防闪烁：在首次渲染前从 localStorage + 系统偏好确定主题
      // 必须用 is:inline，确保在 CSS 加载前同步执行
      // localStorage 存用户偏好：'dark' / 'light' / 'auto'，未设置时默认 'auto'
      (function() {
        var pref = null;
        try { pref = localStorage.getItem('theme'); } catch(e) {}
        if (pref !== 'dark' && pref !== 'light' && pref !== 'auto') {
          pref = 'auto';
        }
        var theme;
        if (pref === 'dark' || pref === 'light') {
          theme = pref;
        } else {
          // auto：跟随系统
          theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        var doc = document.documentElement;
        doc.dataset.theme = theme;
        doc.dataset.themePref = pref; // 供按钮读取用户偏好
        // CSS 加载前就直接设置 html 背景色和文字色，消除任何闪烁
        var isLight = theme === 'light';
        var bg = isLight ? '#f5f7fa' : '#0A0E14';
        var text = isLight ? '#1a1a2e' : '#FFFFFF';
        doc.style.backgroundColor = bg;
        doc.style.color = text;
        doc.style.setProperty('--bg-primary', bg);
        doc.style.setProperty('--text-primary', text);
        doc.style.colorScheme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', bg);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="MACRO EDGE — 宏观投资研究终端 | 资金流 · 宏观体制 · 中美利差 · 全球流动性" />
    <meta name="theme-color" content="#f5f7fa" />
  </head>
  <body>
    <div id="globalLoader" class="global-loader" aria-hidden="true">
      <div class="global-loader-bar"></div>
    </div>
    <Sidebar />
    <header class="header">
      <div class="header-left">
        <button class="hamburger" data-sidebar-toggle aria-label="打开导航" aria-pressed="false">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </button>
        <span class="header-page-title" id="pageTitle"></span>
      </div>
      <div class="header-right">
        <div class="market-status" id="marketStatus">
          <span class="market-status-dot"></span>
          <span class="market-status-text">--</span>
        </div>
        <div class="status-badge">
          <span class="status-dot"></span>
          <span>LIVE</span>
        </div>
        <span class="header-time" id="headerTime">--:--:--</span>
        <span class="freshness-dot freshness-dot--online" id="dataFreshness" data-tooltip="数据已同步"></span>
      </div>
    </header>
    <main class="main">
      <ClientRoot client:load>
        <slot />
      </ClientRoot>
    </main>
  </body>
</html>

<script>
  function updateTime() {
    const el = document.getElementById('headerTime');
    if (el) {
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      const s = String(now.getSeconds()).padStart(2, '0');
      el.innerHTML = `${h}:${m}:<span class="second">${s}</span>`;
    }
  }
  updateTime();
  setInterval(updateTime, 1000);

  // 市场状态判断
  function updateMarketStatus() {
    const el = document.getElementById('marketStatus');
    if (!el) return;
    const now = new Date();
    const day = now.getDay();
    const hour = now.getHours();
    const minute = now.getMinutes();
    const time = hour + minute / 60;

    let status, isOpen;
    if (day === 0 || day === 6) {
      status = '休市';
      isOpen = false;
    } else if ((time >= 9.5 && time < 11.5) || (time >= 13 && time < 15)) {
      status = 'A股开盘';
      isOpen = true;
    } else if (time >= 21.5 || time < 2.5) {
      status = '美股开盘';
      isOpen = true;
    } else {
      status = '已收盘';
      isOpen = false;
    }

    el.classList.toggle('market-status--open', isOpen);
    el.classList.toggle('market-status--close', !isOpen);
    el.querySelector('.market-status-text').textContent = status;
  }
  updateMarketStatus();
  setInterval(updateMarketStatus, 60000);

  // 全局页面导航 loading 进度条
  const loader = document.getElementById('globalLoader');
  let loaderTimer = null;
  let fallbackTimer = null;

  function showLoader() {
    if (!loader || loader.classList.contains('active')) return;
    loader.classList.add('active');
    let progress = 0;
    if (loaderTimer) window.clearInterval(loaderTimer);
    loaderTimer = window.setInterval(() => {
      progress = Math.min(progress + Math.random() * 3, 90);
      const bar = loader.querySelector('.global-loader-bar');
      if (bar) bar.style.width = `${progress}%`;
    }, 200);
  }

  function hideLoader() {
    if (loaderTimer) {
      window.clearInterval(loaderTimer);
      loaderTimer = null;
    }
    const bar = loader?.querySelector('.global-loader-bar');
    if (bar) bar.style.width = '100%';
    setTimeout(() => {
      loader?.classList.remove('active');
      if (bar) bar.style.width = '0%';
    }, 300);
  }

  // 点击内部链接时显示 loading
  document.addEventListener('click', (e) => {
    const target = e.target;
    const link = target.closest('a');
    if (!link) return;
    const href = link.getAttribute('href') || '';
    if (
      !href ||
      href.startsWith('#') ||
      href.startsWith('http') ||
      href.startsWith('mailto:') ||
      href.startsWith('tel:') ||
      link.hasAttribute('download') ||
      link.target === '_blank' ||
      e.metaKey || e.ctrlKey || e.shiftKey
    ) return;

    let url;
    try {
      url = new URL(href, window.location.origin);
    } catch (e2) { return; }
    if (url.origin !== window.location.origin) return;
    if (url.pathname === window.location.pathname && url.search === window.location.search) return;

    showLoader();
    if (fallbackTimer) window.clearTimeout(fallbackTimer);
    fallbackTimer = window.setTimeout(hideLoader, 4000);
  });

  window.addEventListener('pageshow', hideLoader);
  window.addEventListener('pagehide', hideLoader);
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: var(--sidebar-width);
    right: 0;
    height: var(--header-height);
    background: color-mix(in srgb, var(--bg-primary) 35%, transparent);
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    z-index: 50;
    gap: 12px;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .header-page-title {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-medium);
    font-family: var(--font-display);
    color: var(--text-secondary);
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hamburger {
    display: none;
    background: transparent;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    color: var(--text-primary);
    cursor: pointer;
    flex-shrink: 0;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .market-status {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: var(--font-size-xs);
    font-family: var(--font-mono);
    color: var(--text-muted);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    background: var(--bg-card-hover);
    border: 1px solid var(--border-subtle);
  }

  .market-status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--text-muted);
  }

  .market-status--open .market-status-dot {
    background: var(--green);
    box-shadow: 0 0 4px var(--green);
  }

  .market-status--close .market-status-dot {
    background: var(--text-muted);
  }

  .status-badge {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 3px 8px;
    border-radius: 10px;
    font-size: var(--font-size-xs);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent-cyan);
    background: var(--accent-cyan-dim);
    border: 1px solid var(--accent-cyan-dim);
  }

  .status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent-cyan);
    animation: neonPulse 2s ease-in-out infinite;
  }

  .header-time {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    color: var(--text-muted);
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }

  .header-time .second {
    animation: secondPulse 2s ease-in-out infinite;
  }

  .main {
    margin-left: var(--sidebar-width);
    margin-top: var(--header-height);
    min-height: calc(100vh - var(--header-height));
    padding: 24px 28px;
    max-width: var(--content-max-width);
    margin-left: calc(var(--sidebar-width) + max(0px, (100vw - var(--sidebar-width) - var(--content-max-width)) / 2));
  }

  /* 移动端响应式 */
  @media (max-width: 1100px) {
    .main {
      padding: 20px 18px;
    }
  }

  @media (max-width: 767px) {
    .header {
      left: 0;
      padding: 0 16px;
    }

    .hamburger {
      display: flex;
    }

    .main {
      margin-left: 0;
      padding: 16px 14px;
      max-width: none;
    }

    .market-status {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .header {
      padding: 0 12px;
    }

    .header-right {
      gap: 8px;
    }

    .status-badge {
      padding: 3px 6px;
      font-size: 9px;
    }

    .header-time {
      font-size: var(--font-size-xs);
    }

    .main {
      padding: 14px 12px;
    }
  }

  .global-loader {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .global-loader.active {
    opacity: 1;
  }

  .global-loader-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--accent-blue) 0%, var(--accent-cyan) 100%);
    box-shadow: 0 0 10px var(--accent-cyan);
    transition: width 0.2s ease;
  }
</style>