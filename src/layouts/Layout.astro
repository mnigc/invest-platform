---
import '../styles/tokens.css'
import '../styles/global.css'
import Sidebar from '../components/Sidebar.astro'
import ClientRoot from '../components/ClientRoot'
import RelatedSearches from '../components/RelatedSearches.astro'
import { DataFreshness } from '../components/ui/DataFreshness'
import { DonateButton } from '../components/ui/DonateButton'
import { ThemeToggle } from '../components/ui/ThemeToggle'

export interface BreadcrumbItem {
  label: string
  href?: string
}

export interface SearchGroup {
  title: string
  links: Array<{ href: string; label: string }>
}

interface SeoProps {
  title?: string
  description?: string
  canonical?: string
  ogType?: 'website' | 'article'
  ogImage?: string
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>
  hreflang?: Array<{ lang: string; href: string }>
  noindex?: boolean
  breadcrumb?: BreadcrumbItem[]
  relatedSearches?: { groups: SearchGroup[]; universal?: Array<{ href: string; label: string }> }
}

interface Props extends SeoProps {}

const SITE_NAME = 'MACRO EDGE · 宏观投资研究终端'
const SITE_DESCRIPTION =
  'MACRO EDGE 宏观投资研究终端：黄金价格 / 美联储流动性 / 央行购金 / 宏观体制 / 组合信号板，全部数据来自 FRED、Yahoo Finance、官方统计局，研究参考。'
const DEFAULT_OG = '/og-default.png'

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  canonical,
  ogType = 'website',
  ogImage = DEFAULT_OG,
  jsonLd,
  hreflang,
  noindex = false,
  breadcrumb,
  relatedSearches,
} = Astro.props

const siteOrigin = Astro.site?.origin ?? Astro.url.origin
const canonicalHref = canonical
  ? new URL(canonical, siteOrigin).toString()
  : new URL(Astro.url.pathname, siteOrigin).toString()
const ogImageHref = new URL(ogImage, siteOrigin).toString()

const breadcrumbLd = breadcrumb && breadcrumb.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumb.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: item.label,
        ...(item.href ? { item: new URL(item.href, siteOrigin).toString() } : {}),
      })),
    }
  : null
const jsonLdArr = [
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
  ...(breadcrumbLd ? [breadcrumbLd] : []),
]
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="MACRO EDGE · 宏观投资研究终端"
      href="/rss.xml"
    />

    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    )}

    <meta name="theme-color" content="#080B10" />
    <meta name="author" content="MACRO EDGE" />
    <meta name="application-name" content="MACRO EDGE" />
    <meta property="og:site_name" content="MACRO EDGE" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={ogImageHref} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageHref} />

    {hreflang?.map(({ lang, href }) => (
      <link rel="alternate" hreflang={lang} href={new URL(href, siteOrigin).toString()} />
    ))}

    {jsonLdArr.map((data) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    {/* 首帧底色。必须是 <style> 规则而不是 element.style —— 内联样式会长期压过
        global.css 的 html{background-color: rgb(var(--c-bg))}，导致主题切换失效。
        色值需与 tokens.css 的 --c-bg 保持一致。 */}
    <style is:inline>
      html {
        background-color: #080b10;
        color-scheme: dark;
      }
      html[data-theme='light'] {
        background-color: #f2f4f7;
        color-scheme: light;
      }
    </style>

    {/* 防闪烁：CSS 就绪前确定主题。只写 data-theme 属性，不碰任何 CSS 变量。 */}
    <script is:inline>
      ;(function () {
        var pref = null
        try {
          pref = localStorage.getItem('theme')
        } catch (e) {}
        if (pref !== 'dark' && pref !== 'light' && pref !== 'auto') pref = 'auto'
        var theme =
          pref === 'auto'
            ? window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark'
            : pref
        var doc = document.documentElement
        doc.dataset.theme = theme
        doc.dataset.themePref = pref
        var meta = document.querySelector("meta[name='theme-color']")
        if (meta) meta.setAttribute('content', theme === 'light' ? '#F2F4F7' : '#080B10')
      })()
    </script>
  </head>

  <body>
    {/* 路由切换进度条 */}
    <div id="globalLoader" class="global-loader" aria-hidden="true">
      <div class="global-loader-bar"></div>
    </div>

    <Sidebar />

    <div class="shell">
      <header class="topbar">
        <button
          class="nav-trigger"
          data-sidebar-toggle
          aria-label="打开导航"
          aria-pressed="false"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y1="6" />
            <line x1="3" y1="12" x2="21" y1="12" />
            <line x1="3" y1="18" x2="21" y1="18" />
          </svg>
        </button>

        <div class="topbar-brand">MACRO EDGE</div>

        <div class="topbar-actions">
          <DonateButton client:load />
          <DataFreshness client:load />
          <ThemeToggle client:load />
        </div>
      </header>

      <main class="content">
        <ClientRoot client:load>
          {breadcrumb && breadcrumb.length > 0 && (
            <nav aria-label="面包屑" class="mb-3 flex flex-wrap items-center gap-1 text-2xs text-ink-3">
              {breadcrumb.map((item, i) => (
                <>
                  {i > 0 && <span class="text-ink-3/40" aria-hidden="true">/</span>}
                  {item.href ? (
                    <a
                      href={item.href}
                      class="rounded px-1 py-0.5 transition-colors duration-1 ease-terminal hover:bg-surface-2 hover:text-ink-2"
                    >
                      {item.label}
                    </a>
                  ) : (
                    <span class="px-1 py-0.5 text-ink-2">{item.label}</span>
                  )}
                </>
              ))}
            </nav>
          )}
          <slot />
          {relatedSearches && relatedSearches.groups.length > 0 && (
            <RelatedSearches groups={relatedSearches.groups} universal={relatedSearches.universal} />
          )}
        </ClientRoot>
      </main>
    </div>
  </body>
</html>

<script>
  // 站内导航时显示顶部进度条
  const loader = document.getElementById('globalLoader')
  let loaderTimer: number | null = null
  let fallbackTimer: number | null = null

  function showLoader() {
    if (!loader || loader.classList.contains('active')) return
    loader.classList.add('active')
    let progress = 0
    if (loaderTimer) window.clearInterval(loaderTimer)
    loaderTimer = window.setInterval(() => {
      progress = Math.min(progress + Math.random() * 3, 90)
      const bar = loader.querySelector<HTMLElement>('.global-loader-bar')
      if (bar) bar.style.width = `${progress}%`
    }, 200)
  }

  function hideLoader() {
    if (loaderTimer) {
      window.clearInterval(loaderTimer)
      loaderTimer = null
    }
    const bar = loader?.querySelector<HTMLElement>('.global-loader-bar')
    if (bar) bar.style.width = '100%'
    window.setTimeout(() => {
      loader?.classList.remove('active')
      if (bar) bar.style.width = '0%'
    }, 300)
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null
    const link = target?.closest('a')
    if (!link) return
    const href = link.getAttribute('href') || ''
    if (
      !href ||
      href.startsWith('#') ||
      href.startsWith('http') ||
      href.startsWith('mailto:') ||
      href.startsWith('tel:') ||
      link.hasAttribute('download') ||
      link.target === '_blank' ||
      e.metaKey ||
      e.ctrlKey ||
      e.shiftKey
    )
      return

    let url: URL
    try {
      url = new URL(href, window.location.origin)
    } catch {
      return
    }
    if (url.origin !== window.location.origin) return
    if (url.pathname === window.location.pathname && url.search === window.location.search)
      return

    showLoader()
    if (fallbackTimer) window.clearTimeout(fallbackTimer)
    fallbackTimer = window.setTimeout(hideLoader, 4000)
  })

  window.addEventListener('pageshow', hideLoader)
  window.addEventListener('pagehide', hideLoader)
</script>
