---
const navItems = [
  { label: '组合信号板', href: '/signal-board' },
  { label: '黄金决策', href: '/signals/gold' },
      { label: '全球流动性', href: '/indicators/global-liquidity' },
  { label: '知识图谱', href: '/knowledge' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <div class="brand-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 20 L8 12 L12 16 L22 4" />
        <path d="M16 4 L22 4 L22 10" />
      </svg>
    </div>
    <div class="brand-text">
      <div class="brand-title font-orbitron">MACRO EDGE</div>
      <div class="brand-sub">宏观投资研究终端</div>
    </div>
    <button class="sidebar-close" id="sidebarCloseBtn" aria-label="关闭导航">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>

  <nav class="nav">
    {navItems.map(item => (
      <a
        href={item.href}
        class={`nav-link ${isActive(item.href) ? 'active' : ''}`}
        data-sidebar-link
      >
        <span class="nav-indicator"></span>
        <span class="label">{item.label}</span>
      </a>
    ))}
  </nav>

  <div class="sidebar-footer">
    <div class="sidebar-footer-left">
      <div class="data-freshness">
        <span class="freshness-dot freshness-dot--online"></span>
        <span class="sync-label">FRED · Yahoo · akshare</span>
      </div>
      <div class="sync-time" id="syncTime">同步: --:--</div>
    </div>
    <button id="themeToggleBtn" class="theme-toggle" title="切换主题" aria-label="切换主题" aria-pressed="false">
      <span id="themeToggleIcon">🖥️</span>
    </button>
  </div>
</aside>

<div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>

<script>
  (function() {
    var btn = document.getElementById('themeToggleBtn');
    var icon = document.getElementById('themeToggleIcon');
    var sidebar = document.getElementById('sidebar');
    var overlay = document.getElementById('sidebarOverlay');
    var closeBtn = document.getElementById('sidebarCloseBtn');
    if (!btn || !icon) return;

     var THEME_COLORS = { dark: '#0A0E14', light: '#f5f7fa' };
    var PREF_ICONS = { dark: '🌙', light: '☀️', auto: '🖥️' };
    var PREF_LABELS = { dark: '深色模式', light: '浅色模式', auto: '跟随系统' };

    function getPref() {
      var pref = document.documentElement.dataset.themePref;
      if (pref !== 'dark' && pref !== 'light' && pref !== 'auto') {
        pref = 'auto';
      }
      return pref;
    }

    function resolveTheme(pref) {
      if (pref === 'dark' || pref === 'light') return pref;
      return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }

    function updateUI() {
      var pref = getPref();
      var theme = document.documentElement.dataset.theme;
      icon.textContent = PREF_ICONS[pref];
      var themeLabel = theme === 'dark' ? '深色' : '浅色';
      btn.title = PREF_LABELS[pref] + '（当前: ' + themeLabel + '）';
      btn.setAttribute('aria-pressed', theme === 'light' ? 'true' : 'false');
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', THEME_COLORS[theme]);
    }

    function applyAndSync(pref) {
      var doc = document.documentElement;
      var theme = resolveTheme(pref);
      doc.dataset.theme = theme;
      doc.dataset.themePref = pref;
      var bg = theme === 'light' ? '#f5f7fa' : '#0A0E14';
      var text = theme === 'light' ? '#1a1a2e' : '#FFFFFF';
      doc.style.backgroundColor = bg;
      doc.style.color = text;
      doc.style.setProperty('--bg-primary', bg);
      doc.style.setProperty('--text-primary', text);
      doc.style.colorScheme = theme;
      doc.classList.add('theme-transitioning');
      setTimeout(function() { doc.classList.remove('theme-transitioning'); }, 400);
      try { localStorage.setItem('theme', pref); } catch(e) {}
      updateUI();
    }

    function openSidebar() {
      if (!sidebar) return;
      sidebar.classList.add('sidebar-open');
      if (overlay) {
        overlay.classList.add('sidebar-overlay-open');
        overlay.setAttribute('aria-hidden', 'false');
      }
      document.body.style.overflow = 'hidden';
    }
    function closeSidebar() {
      if (!sidebar) return;
      sidebar.classList.remove('sidebar-open');
      if (overlay) {
        overlay.classList.remove('sidebar-overlay-open');
        overlay.setAttribute('aria-hidden', 'true');
      }
      document.body.style.overflow = '';
    }

    // 汉堡按钮由 Layout.astro 提供，事件委托到 document
    document.addEventListener('click', function(e) {
      var target = e.target;
      if (!target) return;
      var hamburger = target.closest('[data-sidebar-toggle]');
      if (hamburger) {
        if (sidebar && sidebar.classList.contains('sidebar-open')) {
          closeSidebar();
        } else {
          openSidebar();
        }
        return;
      }
      if (closeBtn && target.closest('#sidebarCloseBtn')) {
        closeSidebar();
        return;
      }
      if (target.closest('#sidebarOverlay')) {
        closeSidebar();
        return;
      }
      var link = target.closest('[data-sidebar-link]');
      if (link) {
        closeSidebar();
      }
    });

    // Esc 关闭
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeSidebar();
    });

    // 切到桌面尺寸时自动关闭抽屉
    var mqWidth = window.matchMedia('(min-width: 768px)');
    mqWidth.addEventListener('change', function(e) {
      if (e.matches) closeSidebar();
    });

    updateUI();

    // 同步时间显示
    function updateSyncTime() {
      var el = document.getElementById('syncTime');
      if (el) {
        var now = new Date();
        var h = String(now.getHours()).padStart(2, '0');
        var m = String(now.getMinutes()).padStart(2, '0');
        el.textContent = '同步: ' + h + ':' + m;
      }
    }
    updateSyncTime();
    setInterval(updateSyncTime, 60000);

    btn.addEventListener('click', function() {
      var pref = getPref();
      var next = pref === 'dark' ? 'light' : pref === 'light' ? 'auto' : 'dark';
      applyAndSync(next);
    });

    var mq = window.matchMedia('(prefers-color-scheme: dark)');
    mq.addEventListener('change', function() {
      if (getPref() === 'auto') {
        applyAndSync('auto');
      }
    });
  })();
</script>

<style>
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--sidebar-width);
    height: 100vh;
    background: var(--bg-primary);
    border-right: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    z-index: 200;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px 12px;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-subtle);
    flex-shrink: 0;
  }

  .brand-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    background: var(--gradient-brand);
    color: #fff;
    flex-shrink: 0;
    box-shadow: 0 0 12px rgba(59, 130, 246, 0.15);
    transition: box-shadow var(--transition-base);
  }

  .sidebar-brand:hover .brand-icon {
    box-shadow: 0 0 18px rgba(59, 130, 246, 0.25);
  }

  .brand-title {
    font-size: 14px;
    font-weight: 700;
    font-family: var(--font-display);
    letter-spacing: 0.06em;
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .brand-sub {
    font-size: 10px;
    color: var(--text-muted);
    margin-top: 1px;
    letter-spacing: 0.04em;
  }

  .sidebar-close {
    display: none;
    margin-left: auto;
    background: transparent;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    width: 32px;
    height: 32px;
    color: var(--text-muted);
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all var(--transition-fast);
  }

  .sidebar-close:hover {
    background: var(--bg-card-hover);
    border-color: var(--text-muted);
    color: var(--text-primary);
  }

  .nav {
    padding: 8px;
    flex: 1 1 auto;
    overflow-y: auto;
    min-height: 0;
  }

  .nav::-webkit-scrollbar {
    width: 4px;
  }

  .nav::-webkit-scrollbar-track {
    background: transparent;
  }

  .nav::-webkit-scrollbar-thumb {
    background: var(--border-color);
    border-radius: 2px;
  }

  .nav::-webkit-scrollbar-thumb:hover {
    background: var(--text-muted);
  }

  .nav-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 12px;
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-size: var(--font-size-base);
    transition: all var(--transition-fast);
    margin-bottom: 1px;
    overflow: hidden;
  }

  .nav-link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%) scaleY(0);
    width: 3px;
    height: 16px;
    background: var(--gradient-brand);
    transition: transform var(--transition-fast);
    border-radius: 0 2px 2px 0;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--accent-blue-dim) 0%, transparent 60%);
    opacity: 0;
    transition: opacity var(--transition-fast);
    border-radius: var(--radius-md);
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: var(--bg-card-hover);
    padding-left: 14px;
  }

  .nav-link:hover::after {
    opacity: 1;
  }

  .nav-link.active {
    color: var(--accent-blue);
    background: var(--accent-blue-dim);
  }

  .nav-link.active::before {
    transform: translateY(-50%) scaleY(1);
  }

  .nav-link.active::after {
    opacity: 1;
  }

  .nav-indicator {
    width: 3px;
    height: 14px;
    border-radius: 2px;
    background: transparent;
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .label {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sidebar-footer {
    padding: 10px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-primary);
  }

  .sidebar-footer-left {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .data-freshness {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .sync-label {
    font-size: var(--font-size-xs);
    color: var(--text-muted);
    font-family: var(--font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sync-time {
    font-size: 10px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    opacity: 0.7;
  }

  .theme-toggle {
    background: transparent;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    cursor: pointer;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    transition: all var(--transition-fast);
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    background: var(--bg-card-hover);
    border-color: var(--accent-blue);
    box-shadow: 0 0 8px rgba(59, 130, 246, 0.15);
  }

  .theme-toggle:active {
    transform: scale(0.95);
  }

  /* 遮罩层 — 仅在移动端抽屉状态显示 */
  .sidebar-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    z-index: 150;
    pointer-events: none;
  }

  /* 移动端响应式 */
  @media (max-width: 767px) {
    .sidebar {
      transform: translateX(-100%);
      width: 86vw;
      max-width: 320px;
      box-shadow: var(--shadow-lg);
      border-right: none;
    }

    .sidebar.sidebar-open {
      transform: translateX(0);
    }

    .sidebar-overlay.sidebar-overlay-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .sidebar-close {
      display: flex;
    }
  }
</style>


