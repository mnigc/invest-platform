---
const navItems = [
  { label: '组合信号板', href: '/signal-board' },
  { label: '黄金决策', href: '/signals/gold' },
  { label: '全球流动性', href: '/indicators/global-liquidity' },
  { label: '知识图谱', href: '/knowledge' },
]

const currentPath = Astro.url.pathname

function isActive(href: string) {
  if (href === '/') return currentPath === '/'
  return currentPath === href || currentPath.startsWith(href + '/')
}
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <div class="brand-icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 20 L8 12 L12 16 L22 4" />
        <path d="M16 4 L22 4 L22 10" />
      </svg>
    </div>
    <div class="min-w-0 flex-1">
      <div class="brand-title">MACRO EDGE</div>
      <div class="brand-sub">宏观投资研究终端</div>
    </div>
    <button class="sidebar-close" id="sidebarCloseBtn" aria-label="关闭导航">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>

  <nav class="sidebar-nav" aria-label="主导航">
    {
      navItems.map((item) => {
        const active = isActive(item.href)
        return (
          <a
            href={item.href}
            class:list={[
              'group relative flex items-center rounded-md px-3 py-2 text-base transition-colors duration-1 ease-terminal',
              active ? 'bg-accent/10 text-accent' : 'text-ink-2 hover:bg-surface-2 hover:text-ink',
            ]}
            aria-current={active ? 'page' : undefined}
            data-sidebar-link
          >
            <span
              class:list={[
                'absolute left-0 top-1/2 h-4 w-[2px] -translate-y-1/2 rounded-r-full bg-accent transition-transform duration-1 ease-terminal',
                active ? 'scale-y-100' : 'scale-y-0',
              ]}
              aria-hidden="true"
            />
            <span class="relative">{item.label}</span>
          </a>
        )
      })
    }
  </nav>

  <div class="sidebar-foot">
    数据源 FRED · Yahoo · akshare
  </div>
</aside>

<div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>

<script>
  ;(function () {
    var sidebar = document.getElementById('sidebar')
    var overlay = document.getElementById('sidebarOverlay')
    var closeBtn = document.getElementById('sidebarCloseBtn')
    if (!sidebar) return

    var lastFocused: HTMLElement | null = null

    function openSidebar(trigger?: HTMLElement | null) {
      lastFocused = trigger || null
      sidebar!.classList.add('is-open')
      if (overlay) {
        overlay.classList.add('is-open')
        overlay.setAttribute('aria-hidden', 'false')
      }
      document.body.style.overflow = 'hidden'
      closeBtn?.focus()
    }

    function closeSidebar() {
      sidebar!.classList.remove('is-open')
      if (overlay) {
        overlay.classList.remove('is-open')
        overlay.setAttribute('aria-hidden', 'true')
      }
      document.body.style.overflow = ''
      if (lastFocused && document.contains(lastFocused)) lastFocused.focus()
      lastFocused = null
    }

    // 事件委托：汉堡按钮在 Layout.astro，链接在侧栏内部
    document.addEventListener('click', function (e) {
      var target = e.target as HTMLElement | null
      if (!target) return

      var hamburger = target.closest('[data-sidebar-toggle]') as HTMLElement | null
      if (hamburger) {
        if (sidebar!.classList.contains('is-open')) closeSidebar()
        else openSidebar(hamburger)
        return
      }
      if (target.closest('#sidebarCloseBtn') || target.closest('#sidebarOverlay')) {
        closeSidebar()
        return
      }
      if (target.closest('[data-sidebar-link]')) closeSidebar()
    })

    // Esc 关闭 + 抽屉内焦点循环
    document.addEventListener('keydown', function (e) {
      if (!sidebar!.classList.contains('is-open')) return

      if (e.key === 'Escape') {
        closeSidebar()
        return
      }

      if (e.key === 'Tab') {
        var focusables = sidebar!.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        )
        if (!focusables.length) return
        var first = focusables[0]
        var last = focusables[focusables.length - 1]
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault()
          last.focus()
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault()
          first.focus()
        }
      }
    })

    // 切到桌面尺寸时收起抽屉
    window.matchMedia('(min-width: 768px)').addEventListener('change', function (e) {
      if (e.matches) closeSidebar()
    })
  })()
</script>

<style>
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: min(86vw, 320px);
    height: 100vh;
    height: 100dvh;
    z-index: var(--z-sidebar);
    display: flex;
    flex-direction: column;
    background-color: rgb(var(--c-bg));
    border-right: 1px solid rgb(var(--c-border));
    transform: translateX(-100%);
    transition: transform var(--dur-3) var(--ease);
    padding-left: env(safe-area-inset-left);
  }

  /* 桌面端常驻，不做位移 */
  @media (min-width: 768px) {
    .sidebar {
      width: var(--sidebar-width);
      transform: none;
      transition: none;
    }
  }

  .sidebar.is-open {
    transform: translateX(0);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
  }

  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    height: var(--topbar-height);
    flex-shrink: 0;
    padding: 0 12px;
    border-bottom: 1px solid rgb(var(--c-border));
  }

  .brand-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    border-radius: 5px;
    background-color: rgb(var(--c-accent));
    color: #fff;
  }

  .brand-title {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: rgb(var(--c-text));
  }

  .brand-sub {
    font-size: 10px;
    color: rgb(var(--c-text-3));
    letter-spacing: 0.04em;
    margin-top: 1px;
  }

  .sidebar-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border: 1px solid rgb(var(--c-border));
    border-radius: 5px;
    background: transparent;
    color: rgb(var(--c-text-3));
    cursor: pointer;
    transition:
      background-color var(--dur-1) var(--ease),
      color var(--dur-1) var(--ease);
  }

  .sidebar-close:hover {
    background-color: rgb(var(--c-surface-2));
    color: rgb(var(--c-text));
  }

  @media (min-width: 768px) {
    .sidebar-close {
      display: none;
    }
  }

  .sidebar-nav {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar-foot {
    flex-shrink: 0;
    padding: 8px 14px;
    border-top: 1px solid rgb(var(--c-border));
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.02em;
    color: rgb(var(--c-text-3));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sidebar-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    background-color: rgba(0, 0, 0, 0.55);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--dur-2) var(--ease),
      visibility var(--dur-2) var(--ease);
  }

  .sidebar-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  @media (min-width: 768px) {
    .sidebar-overlay {
      display: none;
    }
  }
</style>
