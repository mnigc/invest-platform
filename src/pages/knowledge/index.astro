---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import type { KnowledgeTopic } from '../../components/knowledge/KnowledgeTopicPage';

const TOPICS = await Promise.all([
  import('../../content/knowledge/inflation.json' as any),
  import('../../content/knowledge/deflation.json' as any),
  import('../../content/knowledge/stagflation.json' as any),
  import('../../content/knowledge/interest-rate.json' as any),
]);

const topics: { slug: string; topic: KnowledgeTopic }[] = [
  { slug: 'inflation', topic: TOPICS[0].default as KnowledgeTopic },
  { slug: 'deflation', topic: TOPICS[1].default as KnowledgeTopic },
  { slug: 'stagflation', topic: TOPICS[2].default as KnowledgeTopic },
  { slug: 'interest-rate', topic: TOPICS[3].default as KnowledgeTopic },
];

const EMOJI: Record<string, string> = {
  inflation: '📈', deflation: '📉', stagflation: '🪨', 'interest-rate': '🏦',
};
---

<Layout title="知识图谱 - CN-US MACRO">
  <div class="page-animate">
    <div class="page-header">
      <div class="breadcrumb">
        <a href="/">首页</a>
        <span class="sep">/</span>
        <span>知识图谱</span>
      </div>
      <h1>知识图谱</h1>
      <p class="subtitle">宏观机制可视化：通胀 · 通缩 · 滞胀 · 利率——节点驱动关系，点击查看详解</p>
    </div>

    <div class="topic-grid">
      {topics.map(t => (
        <a class="topic-card" href={`/knowledge/${t.slug}`}>
          <div class="topic-icon">{EMOJI[t.slug] || '🧩'}</div>
          <div class="topic-title">{t.topic.title}</div>
          <div class="topic-sub">{t.topic.subtitle}</div>
          <div class="topic-meta">{t.topic.nodes.length} 个概念 · {t.topic.edges.length} 条关系</div>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  .page-animate { animation: fadeIn 0.3s ease; }
  .page-header { margin-bottom: 20px; }
  .breadcrumb { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--text-muted); margin-bottom: 6px; }
  .breadcrumb a { color: var(--text-muted); transition: color var(--transition-fast); }
  .breadcrumb a:hover { color: var(--accent-cyan); }
  .sep { color: var(--border-color); font-size: 10px; }
  .page-header h1 { font-size: 22px; font-weight: 700; font-family: var(--font-display); letter-spacing: 0.02em; color: var(--text-primary); margin: 0; }
  .subtitle { font-size: 12px; color: var(--text-muted); margin-top: 4px; }
  .topic-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
  .topic-card {
    display: block; padding: 18px; border-radius: 14px; text-decoration: none;
    background: var(--bg-card); border: 1px solid var(--border-light);
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }
  .topic-card:hover { transform: translateY(-2px); border-color: var(--accent-blue); }
  .topic-icon { font-size: 26px; margin-bottom: 8px; }
  .topic-title { font-size: 15px; font-weight: 700; color: var(--text-primary); }
  .topic-sub { font-size: 12px; color: var(--text-muted); margin-top: 4px; line-height: 1.6; }
  .topic-meta { font-size: 11px; color: var(--accent-cyan); margin-top: 10px; }
</style>
