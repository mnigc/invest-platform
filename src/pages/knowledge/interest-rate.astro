---
export const prerender = true

import Layout from '../../layouts/Layout.astro'
import { KnowledgeTopicPage } from '../../components/knowledge/KnowledgeTopicPage'
import raw from '../../content/knowledge/interest-rate.json'

const topic = raw as any
---

<Layout title={`${topic.title} - 知识图谱 - MACRO EDGE`}>
  <div class="animate-enter">
    <KnowledgeTopicPage
      client:load
      topic={topic}
      breadcrumb={[
        { label: '首页', href: '/' },
        { label: '知识图谱', href: '/knowledge' },
        { label: topic.title },
      ]}
    />
  </div>
</Layout>
