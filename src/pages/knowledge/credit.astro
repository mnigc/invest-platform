---
export const prerender = true

import Layout from '../../layouts/Layout.astro'
import { KnowledgeTopicPage } from '../../components/knowledge/KnowledgeTopicPage'
import { findTopic, relatedTopics } from '../../content/knowledge/topics'

const topic = findTopic('credit')!
const related = relatedTopics('credit')
---

<Layout title={`${topic.title} - 知识图谱 - MACRO EDGE`}>
  <div class="animate-enter">
    <KnowledgeTopicPage client:load topic={topic.data} related={related} />
  </div>
</Layout>
