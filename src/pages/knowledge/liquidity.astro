---
export const prerender = true

import Layout from '../../layouts/Layout.astro'
import { KnowledgeTopicPage } from '../../components/knowledge/KnowledgeTopicPage'
import { findTopic, relatedTopics } from '../../content/knowledge/topics'

const entry = findTopic('liquidity')!
const topic = entry.data
const related = relatedTopics('liquidity')
const canonicalPath = `/knowledge/liquidity`

const description = `${topic.title}：${topic.subtitle}。${topic.intro.slice(0, 90)}`

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${topic.title} - 宏观知识图谱`,
  description,
  inLanguage: 'zh-CN',
  author: { '@type': 'Organization', name: 'MACRO EDGE' },
  publisher: { '@type': 'Organization', name: 'MACRO EDGE' },
  keywords: '流动性,美联储,RRP,TGA,净流动性,准备金,SOFR,缩表,扩表',
  mainEntityOfPage: canonicalPath,
}

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: `什么是${topic.title}？`, acceptedAnswer: { '@type': 'Answer', text: topic.intro } },
    { '@type': 'Question', name: `${topic.title}的核心结论是什么？`, acceptedAnswer: { '@type': 'Answer', text: topic.conclusion } },
    ...topic.strategy.slice(0, 4).map((s) => ({
      '@type': 'Question',
      name: `${topic.title}在投资上有什么应用？`,
      acceptedAnswer: { '@type': 'Answer', text: s },
    })),
  ],
}

const breadcrumb = [
  { label: '首页', href: '/' },
  { label: '知识图谱', href: '/knowledge' },
  { label: '流动性机制' },
]

const relatedSearches = {
  groups: [
    {
      title: '流动性相关',
      links: [
        { href: '/indicators/global-liquidity', label: '全球流动性' },
        { href: '/indicators/fed-funds', label: '美联储利率' },
        { href: '/signals/regime', label: '宏观体制' },
        { href: '/analysis/macro-consensus', label: '信号一致性' },
      ],
    },
    {
      title: '其他机制',
      links: [
        { href: '/knowledge/credit', label: '信用机制' },
        { href: '/knowledge/interest-rate', label: '利率机制' },
        { href: '/knowledge/inflation', label: '通胀机制' },
        { href: '/knowledge', label: '查看全部 10 个主题' },
      ],
    },
  ],
  universal: [
    { href: '/signals/gold', label: '黄金价格' },
    { href: '/indicators/dxy', label: '美元指数' },
    { href: '/indicators/cpi', label: 'CPI 通胀' },
    { href: '/indicators/fed-funds', label: '美联储利率' },
    { href: '/indicators/leading', label: '衰退预警' },
  ],
}
---

<Layout
  title={`${topic.title} - 知识图谱 - MACRO EDGE`}
  description={description}
  canonical={canonicalPath}
  jsonLd={[articleJsonLd, faqJsonLd]}
  breadcrumb={breadcrumb}
  relatedSearches={relatedSearches}
>
  <div class="animate-enter">
    <KnowledgeTopicPage client:load topic={topic} related={related} />
  </div>
</Layout>
