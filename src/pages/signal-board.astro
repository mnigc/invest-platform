---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { PageHeader } from '../components/ui/PageHeader';
import { SignalBoardDashboard } from '../components/signals/SignalBoardDashboard';
---

<Layout title="组合信号板 - MACRO EDGE">
  <div class="page-animate">
    <PageHeader
      title="组合信号板"
      subtitle="黄金 / 资金流 / 宏观体制 / 风险异常 / 中美利差 · 多信号加权 · 研究参考"
      breadcrumb={[
        { label: '首页', href: '/' },
        { label: '投资决策' },
        { label: '组合信号板' },
      ]}
    />

    <SignalBoardDashboard client:load />
  </div>
</Layout>

<style>
  .page-animate { animation: fadeIn 0.3s ease; }
</style>
