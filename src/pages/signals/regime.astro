---
export const prerender = true

import Layout from '../../layouts/Layout.astro'
import { PageHeader } from '../../components/ui/PageHeader'
import IndicatorGuide from '../../components/ui/IndicatorGuide.astro'
import { RegimeDetailDashboard } from '../../components/signals/RegimeDetailDashboard'

const description =
  '宏观体制研判：CFNAI、CPI、联邦基金利率、VIX、BBB 信用利差、10Y-2Y 期限利差六维信号加权，映射到金发女孩/风险偏好/过热/滞胀/风险规避/复苏六大体制。'
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: '宏观体制研判数据集',
  description,
  keywords: '宏观体制,CFNAI,CPI,VIX,信用利差,期限利差,衰退,金发女孩,滞胀,资产配置',
  creator: { '@type': 'Organization', name: 'MACRO EDGE' },
  distribution: { '@type': 'DataDownload', encodingFormat: 'text/html' },
  variableMeasured: [
    { '@type': 'PropertyValue', name: 'CFNAI', unitText: 'index' },
    { '@type': 'PropertyValue', name: 'CPI YoY', unitText: 'percent' },
    { '@type': 'PropertyValue', name: 'VIX', unitText: 'index' },
    { '@type': 'PropertyValue', name: 'BBB OAS', unitText: 'percent' },
    { '@type': 'PropertyValue', name: 'T10Y2Y', unitText: 'percent' },
  ],
  temporalCoverage: '1970-01-01/..',
}

const breadcrumb = [
  { label: '首页', href: '/' },
  { label: '信号', href: '/signal-board' },
  { label: '宏观体制' },
]

const relatedSearches = {
  groups: [
    {
      title: '体制相关',
      links: [
        { href: '/knowledge/regime', label: '宏观体制机制' },
        { href: '/analysis/macro-consensus', label: '信号一致性' },
        { href: '/analysis/cross-asset', label: '跨资产联动' },
        { href: '/indicators/leading', label: '衰退预警' },
      ],
    },
    {
      title: '其他',
      links: [
        { href: '/signals/gold', label: '黄金价格' },
        { href: '/indicators/global-liquidity', label: '全球流动性' },
        { href: '/indicators/dxy', label: '美元指数' },
        { href: '/indicators/cpi', label: 'CPI 通胀' },
      ],
    },
  ],
  universal: [
    { href: '/signals/gold', label: '黄金价格' },
    { href: '/indicators/dxy', label: '美元指数' },
    { href: '/indicators/cpi', label: 'CPI 通胀' },
    { href: '/indicators/fed-funds', label: '美联储利率' },
    { href: '/indicators/leading', label: '衰退预警' },
  ],
}
---

<Layout
  title="宏观体制 - MACRO EDGE"
  description={description}
  canonical="/signals/regime"
  jsonLd={jsonLd}
  breadcrumb={breadcrumb}
  relatedSearches={relatedSearches}
>
  <div class="animate-enter">
    <PageHeader
      title="宏观体制研判"
      subtitle="CFNAI · CPI · 联邦利率 · VIX · 信用利差 · 收益率曲线 · 实时体制判定与历史回测"
    />

    <IndicatorGuide>
      <p slot="summary">
        <strong class="text-ink">综合判定：</strong>各指标评分加权后，通过决策树映射到六大体制之一（金发女孩/风险偏好/过热/滞胀/风险规避/复苏）。
      </p>
      <p class="my-1.5">
        <strong class="text-ink">宏观体制</strong>是经济所处周期阶段的综合判断。不同体制下资产表现截然不同：金发女孩环境利好股票，滞胀环境利好实物资产，风险规避环境利好国债和黄金。
      </p>
      <ul class="my-1.5 list-disc space-y-1 pl-5">
        <li>
          <strong class="text-ink">CFNAI（芝加哥联储全国活动指数）</strong> — 衡量经济增长动能。高于零为扩张，低于 -0.7 为衰退信号。
        </li>
        <li>
          <strong class="text-ink">CPI 同比</strong> — 通胀温度计。低于 3% 受控，3-5% 偏高，高于 5% 严重。
        </li>
        <li>
          <strong class="text-ink">VIX 波动率</strong> — 市场恐慌指标。低于 20 平静，20-30 偏高，高于 30 恐慌。
        </li>
        <li>
          <strong class="text-ink">BBB 信用利差</strong> — 信用市场压力。低于 1.5% 宽松，高于 2.5% 紧张。
        </li>
        <li>
          <strong class="text-ink">10Y-2Y 期限利差</strong> — 衰退前瞻指标。深度倒挂（小于 -0.5%）为历史衰退信号。
        </li>
      </ul>
    </IndicatorGuide>

    <RegimeDetailDashboard client:load />
  </div>
</Layout>
