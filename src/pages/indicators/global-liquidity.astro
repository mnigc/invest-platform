---
export const prerender = false

import Layout from '../../layouts/Layout.astro'
import { PageHeader } from '../../components/ui/PageHeader'
import GlobalLiquidityDashboard from '../../components/GlobalLiquidityDashboard'
---

<Layout title="全球流动性 - MACRO EDGE">
  <div class="animate-enter">
    <PageHeader
      title="全球流动性监测"
      subtitle="美联储资产负债表 · RRP · TGA · 主要央行对比 · SOFR"
    />

    <section class="mb-4 rounded-lg border border-line bg-surface p-3.5 text-base leading-relaxed text-ink-2">
      <h2 class="mb-2 text-md font-bold text-ink">指标解读</h2>
      <p class="my-1.5">
        <strong class="text-ink">全球流动性</strong>即市场资金总量。资金充裕时资产价格上行，紧缩时承压。本节跟踪五个核心指标：
      </p>
      <ul class="my-1.5 list-disc space-y-1 pl-5">
        <li>
          <strong class="text-ink">美联储总资产</strong> — 量化宽松与缩表的直接体现。扩表期（2008、2020）显著推高资产价格；缩表期（2022 至今）回收流动性。
        </li>
        <li>
          <strong class="text-ink">RRP（隔夜逆回购）</strong> — 金融体系闲置资金的蓄水池。RRP 高位表明流动性淤积，降至低位则预示市场资金趋紧。
        </li>
        <li>
          <strong class="text-ink">TGA（财政部一般账户）</strong> — 政府存款变动方向即流动性方向：TGA 增加 = 抽走市场资金（紧缩），TGA 减少 = 注入资金（宽松）。
        </li>
        <li>
          <strong class="text-ink">SOFR</strong> — 担保隔夜融资利率，反映银行间资金紧张程度。利率上行即流动性收紧信号。
        </li>
        <li>
          <strong class="text-ink">主要央行资产负债表对比</strong> — 以 100 为基准，横向比较美联储、欧央行、日央行的相对宽松/紧缩节奏。
        </li>
      </ul>
      <p class="mt-2 rounded-md bg-accent/10 p-2.5 text-xs text-ink-2">
        <strong class="text-ink">综合判断：</strong>总资产↑ + RRP↓ + TGA↓ + SOFR↓ = 流动性充裕，利好风险资产；反之则需警惕。
      </p>
    </section>

    <GlobalLiquidityDashboard client:load />
  </div>
</Layout>
