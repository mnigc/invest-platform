---
export const prerender = true

import Layout from '../../layouts/Layout.astro'
import { PageHeader } from '../../components/ui/PageHeader'
import IndicatorGuide from '../../components/ui/IndicatorGuide.astro'
import GlobalLiquidityDashboard from '../../components/GlobalLiquidityDashboard'

const description =
  '全球流动性监测：美联储资产负债表、RRP 隔夜逆回购、TGA 财政部账户、净流动性、银行准备金 WRESBAL、SOFR vs IORB 利差、M1/M2 剪刀差。'
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: '全球流动性数据集',
  description,
  keywords: '美联储,资产负债表,RRP,TGA,净流动性,SOFR,IORB,准备金,M1,M2,全球流动性',
  creator: { '@type': 'Organization', name: 'MACRO EDGE' },
  distribution: { '@type': 'DataDownload', encodingFormat: 'text/html' },
  variableMeasured: [
    { '@type': 'PropertyValue', name: 'WALCL', unitText: 'million USD' },
    { '@type': 'PropertyValue', name: 'RRPONTSYAWARD', unitText: 'million USD' },
    { '@type': 'PropertyValue', name: 'WTREGEN', unitText: 'million USD' },
    { '@type': 'PropertyValue', name: 'WRESBAL', unitText: 'million USD' },
    { '@type': 'PropertyValue', name: 'SOFR', unitText: 'percent' },
    { '@type': 'PropertyValue', name: 'IORB', unitText: 'percent' },
    { '@type': 'PropertyValue', name: 'M1SL', unitText: 'billion USD' },
    { '@type': 'PropertyValue', name: 'M2SL', unitText: 'billion USD' },
  ],
  temporalCoverage: '2002-01-01/..',
}

const breadcrumb = [
  { label: '首页', href: '/' },
  { label: '指标', href: '/signal-board' },
  { label: '全球流动性' },
]

const relatedSearches = {
  groups: [
    {
      title: '流动性相关',
      links: [
        { href: '/knowledge/liquidity', label: '流动性机制' },
        { href: '/indicators/fed-funds', label: '美联储利率' },
        { href: '/signals/regime', label: '宏观体制' },
        { href: '/analysis/macro-consensus', label: '信号一致性' },
      ],
    },
    {
      title: '其他指标',
      links: [
        { href: '/indicators/dxy', label: '美元指数' },
        { href: '/indicators/cpi', label: 'CPI 通胀' },
        { href: '/signals/gold', label: '黄金价格' },
        { href: '/indicators/leading', label: '衰退预警' },
      ],
    },
  ],
  universal: [
    { href: '/signals/gold', label: '黄金价格' },
    { href: '/indicators/dxy', label: '美元指数' },
    { href: '/indicators/cpi', label: 'CPI 通胀' },
    { href: '/indicators/fed-funds', label: '美联储利率' },
    { href: '/indicators/leading', label: '衰退预警' },
  ],
}
---

<Layout
  title="全球流动性 - MACRO EDGE"
  description={description}
  canonical="/indicators/global-liquidity"
  jsonLd={jsonLd}
  breadcrumb={breadcrumb}
  relatedSearches={relatedSearches}
>
  <div class="animate-enter">
    <PageHeader
      title="全球流动性监测"
      subtitle="美联储资产负债表 · RRP · TGA · 净流动性 · 银行准备金 · SOFR vs IORB · M1/M2"
    />

    <IndicatorGuide>
      <p slot="summary">
        <strong class="text-ink">综合判断：</strong>总资产↑ + RRP↓ + TGA↓ + SOFR↓ = 流动性充裕，利好风险资产；反之则需警惕。
      </p>
      <p class="my-1.5">
        <strong class="text-ink">全球流动性</strong>即市场资金总量。资金充裕时资产价格上行，紧缩时承压。本节跟踪五个核心指标：
      </p>
      <ul class="my-1.5 list-disc space-y-1 pl-5">
        <li>
          <strong class="text-ink">美联储总资产</strong> — 量化宽松与缩表的直接体现。扩表期（2008、2020）显著推高资产价格；缩表期（2022 至今）回收流动性。
        </li>
        <li>
          <strong class="text-ink">RRP（隔夜逆回购）</strong> — 金融体系闲置资金的蓄水池。RRP 高位表明流动性淤积，降至低位则预示市场资金趋紧。
        </li>
        <li>
          <strong class="text-ink">TGA（财政部一般账户）</strong> — 政府存款变动方向即流动性方向：TGA 增加 = 抽走市场资金（紧缩），TGA 减少 = 注入资金（宽松）。
        </li>
        <li>
          <strong class="text-ink">SOFR vs IORB</strong> — SOFR 是市场实际成交的回购利率，IORB 是美联储付给准备金的利率
          （货币市场利率的「地板」）。<strong class="text-ink">两者之差</strong>才是真正的融资紧张度：
          SOFR 上穿 IORB 意味着机构宁可付高于政策底的成本也要借到钱 —— 2019 年 9 月的回购危机正是这么起头的。
        </li>
        <li>
          <strong class="text-ink">银行准备金</strong> — 银行体系存放在美联储的余额，是放贷与回购的「弹药」。
          水位持续下行并逼近最低充裕水平（LCLoR）时，回购市场会突发抽紧，并立刻传导到 SOFR。
        </li>
        <li>
          <strong class="text-ink">M1 / M2 剪刀差</strong> — M1 是随时可花的活钱，M2 还含定期等准储蓄。
          剪刀差 = M1同比 − M2同比，<strong class="text-ink">转负</strong>说明资金在「躺平」而非流通，
          是通缩预警链条的第一环。
        </li>
        <li>
          <strong class="text-ink">主要央行资产负债表对比</strong> — 以 100 为基准，横向比较美联储、欧央行、日央行的相对宽松/紧缩节奏。
        </li>
      </ul>
    </IndicatorGuide>

    <GlobalLiquidityDashboard client:load />
  </div>
</Layout>
