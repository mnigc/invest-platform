---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { PageHeader } from '../../components/ui/PageHeader';
import CnUsSpreadDashboard from '../../components/CnUsSpreadDashboard';
---

<Layout title="中美 10 年期国债利差 - MACRO EDGE">
  <div class="page-animate">
    <PageHeader
      title="中美 10 年期国债利差"
      subtitle="中国 10Y − 美国 10Y · 历史分位 · 警戒线 · 倒挂统计"
      breadcrumb={[
        { label: '首页', href: '/' },
        { label: '跨市场分析' },
        { label: '中美利差' },
      ]}
    />

    <CnUsSpreadDashboard client:load />
  </div>
</Layout>

<style>
  .page-animate { animation: fadeIn 0.3s ease; }
</style>
