---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { EtfFlowDashboard } from '../../components/tracking/EtfFlowDashboard';
---

<Layout title="国家队资金追踪 - CN-US MACRO">
  <div class="page-animate">
    <div class="page-header">
      <div class="breadcrumb">
        <a href="/">首页</a>
        <span class="sep">/</span>
        <span>投资决策</span>
        <span class="sep">/</span>
        <span>国家队资金追踪</span>
      </div>
      <h1>国家队资金追踪</h1>
      <p class="subtitle">宽基 ETF 份额 · 净申赎 · 申赎/成交额比率 · 资金 vs 未来涨跌 · 事件研究</p>
    </div>

    <EtfFlowDashboard client:load />
  </div>
</Layout>

<style>
  .page-animate { animation: fadeIn 0.3s ease; }
  .page-header { margin-bottom: 20px; }
  .breadcrumb { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--text-muted); margin-bottom: 6px; }
  .breadcrumb a { color: var(--text-muted); transition: color var(--transition-fast); }
  .breadcrumb a:hover { color: var(--accent-cyan); }
  .sep { color: var(--border-color); font-size: 10px; }
  .page-header h1 { font-size: 22px; font-weight: 700; font-family: var(--font-display); letter-spacing: 0.02em; color: var(--text-primary); margin: 0; }
  .subtitle { font-size: 12px; color: var(--text-muted); margin-top: 4px; }
</style>
