---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { PageHeader } from '../../components/ui/PageHeader';
import { EtfFlowDashboard } from '../../components/tracking/EtfFlowDashboard';
---

<Layout title="国家队资金追踪 - MACRO EDGE">
  <div class="page-animate">
    <PageHeader
      title="国家队资金追踪"
      subtitle="宽基 ETF 份额 · 净申赎 · 申赎/成交额比率 · 资金 vs 未来涨跌 · 事件研究"
      breadcrumb={[
        { label: '首页', href: '/' },
        { label: '投资决策' },
        { label: '国家队资金追踪' },
      ]}
    />

    <EtfFlowDashboard client:load />
  </div>
</Layout>

<style>
  .page-animate { animation: fadeIn 0.3s ease; }
</style>
