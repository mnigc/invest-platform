---
export const prerender = false

import Layout from '../../layouts/Layout.astro'
import { PageHeader } from '../../components/ui/PageHeader'
import IndicatorGuide from '../../components/ui/IndicatorGuide.astro'
import YieldCurveRegimeDashboard from '../../components/analysis/YieldCurveRegimeDashboard'
---

<Layout title="收益率曲线 × 宏观体制联动 - MACRO EDGE">
  <div class="animate-enter">
    <PageHeader
      title="收益率曲线 × 宏观体制联动"
      subtitle="曲线形态与经济周期的交叉分析"
    />
    <IndicatorGuide>
      <p slot="summary">
        <strong class="text-ink">投资指引：</strong>曲线倒挂→防御配置（国债+黄金）；曲线陡峭化→风险资产（股票+信用债）；曲线平坦化→减仓长端利率敏感资产，关注短端机会。
        <span class="text-up">绿色竖线</span>=转向风险偏好，<span class="text-down">红色竖线</span>=转向风险规避，信号点处可观察利差后续演化。
      </p>
      <p class="my-1.5">
        <strong class="text-ink">收益率曲线</strong>反映市场对未来经济增长和通胀的预期。曲线形态变化领先经济周期6-18个月，是最可靠的衰退前瞻指标之一。
      </p>
      <ul class="my-1.5 list-disc space-y-1 pl-5">
        <li>
          <strong class="text-ink">10Y-2Y 期限利差</strong> — 核心衰退指标。高于 0.5% 正常陡峭化，0 至 -0.3% 趋平，低于 -0.5% 深度倒挂（历史衰退信号）。
        </li>
        <li>
          <strong class="text-ink">10Y-3M 期限利差</strong> — 短端利差更敏感。倒挂时银行惜贷，信用收缩加速衰退到来。
        </li>
        <li>
          <strong class="text-ink">曲线形态（陡峭/平坦/倒挂）</strong> — 陡峭化=复苏初期，平坦化=周期中后段，倒挂=衰退临近。
        </li>
        <li>
          <strong class="text-ink">3M / 2Y / 10Y / 30Y 各期限利率</strong> — 短端受联储政策驱动，长端反映增长通胀预期。长端下行快于短端=衰退定价。
        </li>
      </ul>
    </IndicatorGuide>

    <YieldCurveRegimeDashboard client:load />
  </div>
</Layout>
