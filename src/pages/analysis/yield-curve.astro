---
export const prerender = true

import Layout from '../../layouts/Layout.astro'
import { PageHeader } from '../../components/ui/PageHeader'
import IndicatorGuide from '../../components/ui/IndicatorGuide.astro'
import YieldCurveRegimeDashboard from '../../components/analysis/YieldCurveRegimeDashboard'

const description =
  '收益率曲线与宏观体制联动：10Y-2Y、10Y-3M 期限利差，3M / 2Y / 10Y / 30Y 期限结构，与六大宏观体制的对应关系。'
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: '收益率曲线体制联动数据集',
  description,
  keywords: '收益率曲线,期限利差,10Y-2Y,10Y-3M,衰退前瞻,陡峭化,平坦化,曲线倒挂',
  creator: { '@type': 'Organization', name: 'MACRO EDGE' },
  distribution: { '@type': 'DataDownload', encodingFormat: 'text/html' },
  variableMeasured: [
    { '@type': 'PropertyValue', name: 'DGS3MO', unitText: 'percent' },
    { '@type': 'PropertyValue', name: 'DGS2', unitText: 'percent' },
    { '@type': 'PropertyValue', name: 'DGS10', unitText: 'percent' },
    { '@type': 'PropertyValue', name: 'DGS30', unitText: 'percent' },
    { '@type': 'PropertyValue', name: 'T10Y2Y', unitText: 'percent' },
    { '@type': 'PropertyValue', name: 'T10Y3M', unitText: 'percent' },
  ],
  temporalCoverage: '1962-01-01/..',
}

const breadcrumb = [
  { label: '首页', href: '/' },
  { label: '分析', href: '/signal-board' },
  { label: '收益率曲线' },
]

const relatedSearches = {
  groups: [
    {
      title: '曲线相关',
      links: [
        { href: '/knowledge/recession', label: '衰退预警机制' },
        { href: '/analysis/credit-stress', label: '信用压力' },
        { href: '/indicators/fed-funds', label: '美联储利率' },
        { href: '/analysis/inflation-anchor', label: '通胀锚定' },
      ],
    },
    {
      title: '其他',
      links: [
        { href: '/signals/regime', label: '宏观体制' },
        { href: '/signals/gold', label: '黄金价格' },
        { href: '/indicators/leading', label: '衰退预警' },
        { href: '/analysis/cross-asset', label: '跨资产联动' },
      ],
    },
  ],
  universal: [
    { href: '/signals/gold', label: '黄金价格' },
    { href: '/indicators/dxy', label: '美元指数' },
    { href: '/indicators/cpi', label: 'CPI 通胀' },
    { href: '/indicators/fed-funds', label: '美联储利率' },
    { href: '/indicators/leading', label: '衰退预警' },
  ],
}
---

<Layout
  title="收益率曲线 × 宏观体制联动 - MACRO EDGE"
  description={description}
  canonical="/analysis/yield-curve"
  jsonLd={jsonLd}
  breadcrumb={breadcrumb}
  relatedSearches={relatedSearches}
>
  <div class="animate-enter">
    <PageHeader
      title="收益率曲线 × 宏观体制联动"
      subtitle="曲线形态与经济周期的交叉分析"
    />
    <IndicatorGuide>
      <p slot="summary">
        <strong class="text-ink">投资指引：</strong>曲线倒挂→防御配置（国债+黄金）；曲线陡峭化→风险资产（股票+信用债）；曲线平坦化→减仓长端利率敏感资产，关注短端机会。
        <span class="text-up">绿色竖线</span>=转向风险偏好，<span class="text-down">红色竖线</span>=转向风险规避，信号点处可观察利差后续演化。
      </p>
      <p class="my-1.5">
        <strong class="text-ink">收益率曲线</strong>反映市场对未来经济增长和通胀的预期。曲线形态变化领先经济周期6-18个月，是最可靠的衰退前瞻指标之一。
      </p>
      <ul class="my-1.5 list-disc space-y-1 pl-5">
        <li>
          <strong class="text-ink">10Y-2Y 期限利差</strong> — 核心衰退指标。高于 0.5% 正常陡峭化，0 至 -0.3% 趋平，低于 -0.5% 深度倒挂（历史衰退信号）。
        </li>
        <li>
          <strong class="text-ink">10Y-3M 期限利差</strong> — 短端利差更敏感。倒挂时银行惜贷，信用收缩加速衰退到来。
        </li>
        <li>
          <strong class="text-ink">曲线形态（陡峭/平坦/倒挂）</strong> — 陡峭化=复苏初期，平坦化=周期中后段，倒挂=衰退临近。
        </li>
        <li>
          <strong class="text-ink">3M / 2Y / 10Y / 30Y 各期限利率</strong> — 短端受联储政策驱动，长端反映增长通胀预期。长端下行快于短端=衰退定价。
        </li>
      </ul>
    </IndicatorGuide>

    <YieldCurveRegimeDashboard client:load />
  </div>
</Layout>
