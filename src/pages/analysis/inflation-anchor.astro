---
export const prerender = true

import Layout from '../../layouts/Layout.astro'
import { PageHeader } from '../../components/ui/PageHeader'
import IndicatorGuide from '../../components/ui/IndicatorGuide.astro'
import InflationAnchorDashboard from '../../components/analysis/InflationAnchorDashboard'

const description =
  '通胀预期锚定分析：5Y / 10Y TIPS 隐含通胀率与联储 2% 目标的偏离、5Y5Y 远期通胀、实际利率、滚动 Z-Score。'
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: '通胀预期锚定分析数据集',
  description,
  keywords: 'TIPS,盈亏平衡通胀,5Y5Y,实际利率,通胀锚定,通缩,脱锚,通胀预期',
  creator: { '@type': 'Organization', name: 'MACRO EDGE' },
  distribution: { '@type': 'DataDownload', encodingFormat: 'text/html' },
  variableMeasured: [
    { '@type': 'PropertyValue', name: 'T5YIE', unitText: 'percent' },
    { '@type': 'PropertyValue', name: 'T10YIE', unitText: 'percent' },
    { '@type': 'PropertyValue', name: 'DFII5', unitText: 'percent' },
    { '@type': 'PropertyValue', name: 'DFII10', unitText: 'percent' },
    { '@type': 'PropertyValue', name: 'CPIAUCSL YoY', unitText: 'percent' },
  ],
  temporalCoverage: '2003-01-01/..',
}

const breadcrumb = [
  { label: '首页', href: '/' },
  { label: '分析', href: '/signal-board' },
  { label: '通胀锚定' },
]

const relatedSearches = {
  groups: [
    {
      title: '通胀相关',
      links: [
        { href: '/knowledge/inflation', label: '通胀机制' },
        { href: '/indicators/cpi', label: 'CPI 通胀数据' },
        { href: '/signals/gold', label: '黄金价格' },
        { href: '/signals/regime', label: '宏观体制' },
      ],
    },
    {
      title: '其他',
      links: [
        { href: '/analysis/yield-curve', label: '收益率曲线' },
        { href: '/analysis/credit-stress', label: '信用压力' },
        { href: '/indicators/fed-funds', label: '美联储利率' },
        { href: '/indicators/global-liquidity', label: '全球流动性' },
      ],
    },
  ],
  universal: [
    { href: '/signals/gold', label: '黄金价格' },
    { href: '/indicators/dxy', label: '美元指数' },
    { href: '/indicators/cpi', label: 'CPI 通胀' },
    { href: '/indicators/fed-funds', label: '美联储利率' },
    { href: '/indicators/leading', label: '衰退预警' },
  ],
}
---

<Layout
  title="通胀预期锚定分析 - MACRO EDGE"
  description={description}
  canonical="/analysis/inflation-anchor"
  jsonLd={jsonLd}
  breadcrumb={breadcrumb}
  relatedSearches={relatedSearches}
>
  <div class="animate-enter">
    <PageHeader
      title="通胀预期锚定分析"
      subtitle="TIPS隐含通胀率 vs 联储2%目标的偏离分析"
    />
    <IndicatorGuide>
      <p slot="summary">
        <strong class="text-ink">投资指引：</strong>偏离度 &gt; +0.5% → 配置抗通胀资产（TIPS/大宗商品/能源股）；偏离度 &lt; -0.5% → 通缩风险，增配长久期国债；锚定稳定时 → 正常配置，关注实际利率方向。
      </p>
      <p class="my-1.5">
        <strong class="text-ink">通胀预期锚定</strong>衡量市场通胀预期是否稳定在联储 2% 目标附近。锚定松动时，联储可能被迫激进加息，引发资产重估。
      </p>
      <ul class="my-1.5 list-disc space-y-1 pl-5">
        <li>
          <strong class="text-ink">5Y / 10Y 盈亏平衡通胀率（TIPS）</strong> — 市场隐含的年均通胀预期。10Y 稳定在 2% 附近=锚定良好，持续高于 2.5%=通胀预期脱锚。
        </li>
        <li>
          <strong class="text-ink">实际利率（TIPS Yield）</strong> — 名义利率减通胀预期。负实际利率=货币宽松，高实际利率=货币紧缩（页面右上"实际利率期限结构"图同步展示 5/10/20/30Y 曲线）。
        </li>
        <li>
          <strong class="text-ink">偏离度（盈亏平衡 - 联储目标）</strong> — 正偏离=通胀预期过高，负偏离=通缩担忧。偏离越大政策转向概率越高；±0.5% 为政策响应阈值、±0.8% 为脱锚边界。
        </li>
        <li>
          <strong class="text-ink">5Y5Y 远期通胀预期</strong> — 由 2×10Y−5Y 换算，衡量"5 年后 5 年期"的长期通胀预期，比同期盈亏平衡更纯净（消除流动性溢价）。>2.5% 视为长期脱锚信号。
        </li>
        <li>
          <strong class="text-ink">5Y vs 10Y 期限结构</strong> — 短端反映近期政策，长端反映长期信心。5Y&gt;10Y=短期通胀压力更大。
        </li>
        <li>
          <strong class="text-ink">预期 vs 已实现（CPI YoY 缺口）</strong> — 盈亏平衡相对已实现 CPI 的溢价=市场要求的通胀补偿。溢价持续走阔通常伴随商品/周期压力；缺口转负=通胀预期偏低，需警惕通缩风险。
        </li>
        <li>
          <strong class="text-ink">滚动 Z-Score</strong> — 偏差的 1 年滚动标准化值。|Z|&gt;1 偏离常态边缘，|Z|&gt;2 视为偏差脱轨。
        </li>
      </ul>
    </IndicatorGuide>

    <InflationAnchorDashboard client:load />
  </div>
</Layout>
