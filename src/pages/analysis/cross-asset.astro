---
export const prerender = true

import Layout from '../../layouts/Layout.astro'
import { PageHeader } from '../../components/ui/PageHeader'
import IndicatorGuide from '../../components/ui/IndicatorGuide.astro'
import CrossAssetDashboard from '../../components/analysis/CrossAssetDashboard'

const description =
  '跨资产联动矩阵：国债-信用利差、国债-VIX、实际利率-VIX 等关键资产对的滚动相关性（63 日 / 252 日），监控分散化失效与市场结构转换。'
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: '跨资产联动矩阵数据集',
  description,
  keywords: '跨资产,相关性,分散化,国债,VIX,实际利率,风险偏好,资产配置',
  creator: { '@type': 'Organization', name: 'MACRO EDGE' },
  distribution: { '@type': 'DataDownload', encodingFormat: 'text/html' },
  temporalCoverage: '2010-01-01/..',
}

const breadcrumb = [
  { label: '首页', href: '/' },
  { label: '分析', href: '/signal-board' },
  { label: '跨资产联动' },
]

const relatedSearches = {
  groups: [
    {
      title: '相关',
      links: [
        { href: '/knowledge/cross-asset', label: '跨资产机制' },
        { href: '/signal-board', label: '宏观信号板' },
        { href: '/signals/regime', label: '宏观体制' },
        { href: '/analysis/macro-consensus', label: '信号一致性' },
      ],
    },
    {
      title: '其他',
      links: [
        { href: '/signals/gold', label: '黄金价格' },
        { href: '/indicators/global-liquidity', label: '全球流动性' },
        { href: '/indicators/dxy', label: '美元指数' },
        { href: '/indicators/leading', label: '衰退预警' },
      ],
    },
  ],
  universal: [
    { href: '/signals/gold', label: '黄金价格' },
    { href: '/indicators/dxy', label: '美元指数' },
    { href: '/indicators/cpi', label: 'CPI 通胀' },
    { href: '/indicators/fed-funds', label: '美联储利率' },
    { href: '/indicators/leading', label: '衰退预警' },
  ],
}
---

<Layout
  title="跨资产联动矩阵 - MACRO EDGE"
  description={description}
  canonical="/analysis/cross-asset"
  jsonLd={jsonLd}
  breadcrumb={breadcrumb}
  relatedSearches={relatedSearches}
>
  <div class="animate-enter">
    <PageHeader
      title="跨资产联动矩阵"
      subtitle="动态相关性变化检测与分散化分析"
    />
    <IndicatorGuide>
      <p slot="summary">
        <strong class="text-ink">投资指引：</strong>多数资产对相关性飙升 → 分散化失效，减仓+增加现金比例；国债与风险资产负相关恢复 → 分散化有效，可正常配置；实际利率与 VIX 正相关加强 → 货币政策主导市场，紧盯利率方向。
      </p>
      <p class="my-1.5">
        <strong class="text-ink">跨资产联动</strong>衡量不同资产类别之间的相关性变化。正常市场相关性稳定，危机来临时相关性急剧上升（"一切同跌"），分散化失效。
      </p>
      <ul class="my-1.5 list-disc space-y-1 pl-5">
        <li>
          <strong class="text-ink">国债-BBB 利差相关性</strong> — 正相关=正常市场，负相关=避险资金从信用债流向国债。相关性突变=市场结构转换。
        </li>
        <li>
          <strong class="text-ink">国债-HY 利差相关性</strong> — 与 BBB 类似但 HY 更敏感。HY 与国债负相关加深=信用恐慌加剧。
        </li>
        <li>
          <strong class="text-ink">国债-VIX 相关性</strong> — 正相关=国债与恐慌同升（典型避险）。负相关=市场情绪分化。
        </li>
        <li>
          <strong class="text-ink">实际利率-VIX 相关性</strong> — 衡量货币政策与市场恐慌的联动。高正相关=紧缩政策直接冲击风险偏好。
        </li>
        <li>
          <strong class="text-ink">滚动窗口相关性（63日/252日）</strong> — 短窗口捕捉突发事件，长窗口反映结构性变化。窗口差异大=短期冲击vs长期趋势。
        </li>
      </ul>
    </IndicatorGuide>

    <CrossAssetDashboard client:load />
  </div>
</Layout>
