---
export const prerender = true

import Layout from '../../layouts/Layout.astro'
import { PageHeader } from '../../components/ui/PageHeader'
import IndicatorGuide from '../../components/ui/IndicatorGuide.astro'
import CreditStressDashboard from '../../components/analysis/CreditStressDashboard'

const description =
  '信用-利率交叉压力分析：BBB / AAA / HY 各档信用利差与 10Y / 2Y 国债收益率交叉，识别避险模式、紧缩性信用收缩与信用修复期。'
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: '信用-利率交叉压力分析数据集',
  description,
  keywords: 'BBB 利差,HY 利差,信用利差,国债收益率,衰退信号,信用修复,高收益债',
  creator: { '@type': 'Organization', name: 'MACRO EDGE' },
  distribution: { '@type': 'DataDownload', encodingFormat: 'text/html' },
  variableMeasured: [
    { '@type': 'PropertyValue', name: 'BAMLC0A0CM', unitText: 'percent' },
    { '@type': 'PropertyValue', name: 'BAMLH0A0HYM2', unitText: 'percent' },
    { '@type': 'PropertyValue', name: 'AAA OAS', unitText: 'percent' },
    { '@type': 'PropertyValue', name: 'DGS10', unitText: 'percent' },
    { '@type': 'PropertyValue', name: 'DGS2', unitText: 'percent' },
  ],
  temporalCoverage: '1996-01-01/..',
}

const breadcrumb = [
  { label: '首页', href: '/' },
  { label: '分析', href: '/signal-board' },
  { label: '信用-利率压力' },
]

const relatedSearches = {
  groups: [
    {
      title: '信用相关',
      links: [
        { href: '/knowledge/credit', label: '信用周期机制' },
        { href: '/analysis/yield-curve', label: '收益率曲线' },
        { href: '/analysis/macro-consensus', label: '信号一致性' },
        { href: '/indicators/leading', label: '衰退预警' },
      ],
    },
    {
      title: '其他',
      links: [
        { href: '/signals/gold', label: '黄金价格' },
        { href: '/signals/regime', label: '宏观体制' },
        { href: '/indicators/global-liquidity', label: '全球流动性' },
        { href: '/indicators/dxy', label: '美元指数' },
      ],
    },
  ],
  universal: [
    { href: '/signals/gold', label: '黄金价格' },
    { href: '/indicators/dxy', label: '美元指数' },
    { href: '/indicators/cpi', label: 'CPI 通胀' },
    { href: '/indicators/fed-funds', label: '美联储利率' },
    { href: '/indicators/leading', label: '衰退预警' },
  ],
}
---

<Layout
  title="信用-利率交叉压力分析 - MACRO EDGE"
  description={description}
  canonical="/analysis/credit-stress"
  jsonLd={jsonLd}
  breadcrumb={breadcrumb}
  relatedSearches={relatedSearches}
>
  <div class="animate-enter">
    <PageHeader
      title="信用-利率交叉压力分析"
      subtitle="利差扩张 × 利率下行 = 衰退信号"
    />
    <IndicatorGuide>
      <p slot="summary">
        <strong class="text-ink">投资指引：</strong>BBB 利差 &gt; 2.5% + 利率下行 → 避险模式（国债+黄金），减持信用债；利差收窄 + 利率企稳 → 信用修复初期，可抄底高收益债；利差稳定低位 → 正常配置，享受信用溢价。
      </p>
      <p class="my-1.5">
        <strong class="text-ink">信用-利率交叉压力</strong>同时监测信用市场和利率市场。两者同步恶化是最强衰退信号——信用利差扩大+利率下行=资金逃离风险资产涌入国债。
      </p>
      <ul class="my-1.5 list-disc space-y-1 pl-5">
        <li>
          <strong class="text-ink">BBB 投资级利差</strong> — 信用市场温度计。低于 1.5% 宽松，1.5-2.5% 正常，高于 2.5% 紧张，高于 4% 危机。
        </li>
        <li>
          <strong class="text-ink">HY 高收益利差</strong> — 垃圾债利差反映最脆弱企业的融资压力。HY 利差 &gt; 8% = 市场定价大规模违约。
        </li>
        <li>
          <strong class="text-ink">AAA 利差</strong> — 最优质企业债利差，与 BBB 利差对比可判断信用分层是否加剧。
        </li>
        <li>
          <strong class="text-ink">10Y / 2Y 国债收益率</strong> — 利率环境背景。利率下行+利差扩大=典型衰退模式；利率上行+利差扩大=紧缩性信用收缩。
        </li>
      </ul>
    </IndicatorGuide>

    <CreditStressDashboard client:load />
  </div>
</Layout>
