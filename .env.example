# 数据库配置（必填）—— Supabase 连接串
# "Project Settings → Database → Connection string" 的 URI 格式：
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres （Session pooler，推荐）
#   postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres （直连，需要时）
DATABASE_URL=postgresql://postgres.XXXXXX:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# 站点服务配置
HOST=0.0.0.0
PORT=4321
SITE_URL=https://your-domain.com

# FRED API Key（同步脚本用）
FRED_API_KEY=
